@page
@model Portfolio.Pages.Experience.IndexModel
@{
    ViewData["Title"] = "Experience";
}

<h1>@ViewData["Title"]</h1>
<h3>@ViewData["Message"]</h3>
<section aria-labelledby="experience-context"><h2 id="experience-context">Professional experience and development</h2><p>I serve as Sr. Software Architect (Portfolio Architect), February 2026–present, following my Engineering Manager role from February 2021 to February 2026. Explore the current work and the historical chronology below.</p><p><a asp-page="/Experience/EmploymentAccomplishments">Employment accomplishments</a> · <a asp-page="/Architecture">Architecture &amp; Governance</a> · <a asp-page="/Experience/ResumeHistory">Historical technical and personal record</a></p></section>

<div class="row">
    <div class="col-md-12">
        <p>&nbsp;</p>
    </div>
    <div class="col-md-4">
        <h3>About Me</h3>
        <p>A bit more about me personally, including my background and work experience.</p>
        <p>
            <a class="btn btn-info btn-site" asp-area="" asp-page="/AboutMe">About Me >></a>
        </p>
    </div>
    <div class="col-md-4">
        <h3>Education</h3>
        <p>This is a deeper dive into my scholastic education and college experience.</p>
        <p>
            <a class="btn btn-info btn-site" asp-area="" asp-page="/Experience/Education">Learn more >></a>
        </p>
    </div>
    <div class="col-md-4">
        <h3>Work History</h3>
        <p>This details my work history and various employment opportunities that I had.</p>
        <p>
            <a class="btn btn-info btn-site" asp-area="" asp-page="/Experience/WorkHistory">Learn more >></a>
        </p>
    </div>
</div>
