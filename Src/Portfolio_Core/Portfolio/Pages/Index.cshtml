@page
@model IndexModel
@{ ViewData["Title"] = "Portfolio architecture and engineering leadership"; }
<section class="home-hero" aria-label="Introduction">
    <div>
        <p class="eyebrow">
            <i class="bi bi-compass" aria-hidden="true"></i> Architecture · Governance · Engineering leadership
        </p>
        <h1>
            Michael B. Carey
        </h1>
        <p class="hero-role">
            Sr. Software Architect <span>(Portfolio Architect)</span>
        </p>
        <p class="lead">
            I turn product goals into reliable software through hands-on engineering, architecture, and team leadership.
        </p>
        <p>
            My foundation spans quality assurance, software development, and engineering management. Today, I guide portfolio architecture, enterprise governance, and practical modernization.
        </p>
        <div class="hero-actions">
            <a class="btn btn-primary" asp-page="/Architecture">Architecture &amp; Governance</a><a class="btn btn-outline-primary" asp-page="/Experience/EmploymentAccomplishments">Employment Accomplishments</a>
        </div>
    </div>
    <img class="hero-portrait" src="~/content/images/Michael_Carey_Large.jpg" alt="Michael B. Carey" width="320" height="390"/>
</section>
<section class="content-section">
    <p class="eyebrow">
        How I work
    </p>
    <h2>
        Maintainable systems. Clear decisions. Strong teams.
    </h2>
    <p>
        I prioritize maintainability, correctness, and delivery speed—in that order. Clear domain boundaries, explicit contracts, incremental modernization, and early stakeholder alignment help teams make decisions they can sustain.
    </p>
    <a asp-page="/Architecture">Read my architecture and governance approach →</a>
</section>
<section class="content-section">
    <p class="eyebrow">
        Professional practice
    </p>
    <h2>
        Strategy grounded in delivery
    </h2>
    <div class="feature-grid">
        <article>
            <h3>
                AI &amp; Innovation
            </h3>
            <p>
                AI-enabled product development, engineering automation, and enterprise AI adoption with human accountability.
            </p>
            <a asp-page="/Skills/AI">Explore AI work →</a>
        </article>
        <article>
            <h3>
                Engineering &amp; QA
            </h3>
            <p>
                Software delivery, automation, cloud services, and quality engineering built on hands-on technical experience.
            </p>
            <a asp-page="/Skills/Technologies">Explore engineering →</a>
        </article>
        <article>
            <h3>
                Leadership
            </h3>
            <p>
                Guided autonomy, mentoring, transparent communication, and collaboration across teams and stakeholders.
            </p>
            <a asp-page="/Skills/Leadership">Explore leadership →</a>
        </article>
    </div>
</section>
<section class="content-section">
    <p class="eyebrow">
        Evidence in practice
    </p>
    <h2>
        Selected work
    </h2>
    <div class="project-grid">
        <article class="project-card">
            <p>
                I was the primary developer of a QA automation framework and authored enterprise QA modernization strategies bringing together repository-owned testing, shared QA platform capabilities, end-to-end validation, and objective release governance. <a asp-page="/Experience/EmploymentAccomplishments" asp-fragment="quality-engineering">Read the quality engineering work</a>.
            </p>
        </article>
        <article class="project-card">
            <p>
                I created C#/.NET and Node.js/React starter template projects and implemented internal-system, Zendesk, and API integrations and services. <a asp-page="/Experience/EmploymentAccomplishments" asp-fragment="software-delivery">Read the software delivery work</a>.
            </p>
        </article>
    </div>
</section>
<section class="content-section">
    <h2>
        Experience beyond a single role
    </h2>
    <p>
        My career, independent projects, education, entrepreneurship, and community interests shape how I approach technology and leadership.
    </p>
    <ul class="connection-list">
        <li>
            <a asp-page="/Experience/WorkHistory">Work history</a>
        </li>
        <li>
            <a asp-page="/Projects/Index">Projects</a>
        </li>
        <li>
            <a asp-page="/Skills/Index">Skills</a>
        </li>
        <li>
            <a asp-page="/Experience/Index">Experience</a>
        </li>
        <li>
            <a asp-page="/Explore">Explore the full portfolio</a>
        </li>
    </ul>
</section>
<section class="content-section">
    <h2>
        Connect
    </h2>
    <ul class="connection-list">
        <li>
            <a href="https://www.linkedin.com/in/michael-carey-13899627/" target="_blank" rel="noopener">LinkedIn</a>
        </li>
        <li>
            <a href="https://github.com/MCLifeLeader" target="_blank" rel="noopener">GitHub</a>
        </li>
        <li>
            <a asp-page="/AboutMe" asp-fragment="connections">Social Media</a>
        </li>
    </ul>
</section>
