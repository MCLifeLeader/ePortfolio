@page
@{ ViewData["Title"] = "Zendesk Integration"; }
<header class="page-header">
    <p class="page-kicker">
        <i class="bi bi-link-45deg" aria-hidden="true"></i> Connected systems
    </p>
    <h1>
        Zendesk Integration
    </h1>
    <p class="page-intro">
        Help-center documentation, training, and custom role-based access integration.
    </p>
</header>
<div class="reading-layout">
    <div class="reading-main">
        <section class="content-panel prose">
            <h2>
                Internal-System Integration
            </h2>
            <p>
                Zendesk is a third-party platform we use for help-center documentation and training. I integrated it with internal services that provide custom role-based access.
            </p>
            <p>
                This work is part of my broader experience developing API integrations and services that connect applications and support product functionality.
            </p>
            <p>
                My integration approach emphasizes explicit contracts, clear responsibilities, validation, and diagnostic visibility so connected systems can be maintained and supported as they evolve.
            </p>
            <p>
                <a asp-page="/Skills/SystemsIntegration">Systems and API integration</a> · <a asp-page="/Skills/WebApi">API engineering</a> · <a asp-page="/Experience/EmploymentAccomplishments" asp-fragment="software-delivery">Delivered integration work</a>
            </p>
        </section>
    </div>
    <aside class="reading-aside">
        <section class="content-panel">
            <h2>
                Skills
            </h2>
            <ul class="tag-list">
                <li>
                    Zendesk help-center integration
                </li>
                <li>
                    Documentation and training platform
                </li>
                <li>
                    Custom role-based access services
                </li>
                <li>
                    Internal-system integration
                </li>
                <li>
                    API integrations and services
                </li>
                <li>
                    Integration contracts and ownership
                </li>
                <li>
                    Validation and diagnostics
                </li>
            </ul>
        </section>
    </aside>
</div>
