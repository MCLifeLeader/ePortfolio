@page
@{ ViewData["Title"] = "Okta, OAuth and OpenID Connect"; }
<header class="page-header">
    <p class="page-kicker">
        <i class="bi bi-shield-lock" aria-hidden="true"></i> Application identity
    </p>
    <h1>
        Okta, OAuth and OpenID Connect
    </h1>
    <p class="page-intro">
        Hands-on identity integration in an application starter.
    </p>
</header>
<div class="reading-layout">
    <div class="reading-main">
        <section class="content-panel prose">
            <h2>
                Starter Application Integration
            </h2>
            <p>
                I wired OAuth and OpenID Connect (OIDC) into my starter application using Okta. This work connects an external identity provider with the application foundation used for product development.
            </p>
            <p>
                My identity experience sits alongside full-stack application delivery, API engineering, and reusable starter architecture. I consider identity boundaries as part of the wider application's integration and security design.
            </p>
            <p>
                <a asp-page="/Skills/CSharp">.NET application engineering</a> · <a asp-page="/Skills/WebApi">API engineering</a> · <a asp-page="/Skills/SystemsIntegration">Systems integration</a>
            </p>
        </section>
    </div>
    <aside class="reading-aside">
        <section class="content-panel">
            <h2>
                Skills
            </h2>
            <ul class="tag-list">
                <li>
                    Okta integration
                </li>
                <li>
                    OAuth
                </li>
                <li>
                    OpenID Connect / OIDC
                </li>
                <li>
                    Starter application identity
                </li>
                <li>
                    External identity provider integration
                </li>
            </ul>
        </section>
    </aside>
</div>
