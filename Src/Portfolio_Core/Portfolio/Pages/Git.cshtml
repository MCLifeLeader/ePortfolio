@page
@model Portfolio.Pages.GitModel
@{
    ViewData["Title"] = "Git Repo List";
}
<header class="page-header">
    <p class="page-kicker">
        <i class="bi bi-compass" aria-hidden="true"></i> Public repositories
    </p>
    <h1>
        @ViewData["Title"]
    </h1>
    <p class="page-intro">
        Platform foundations, learning projects, teaching material, and the code behind this portfolio.
    </p>
</header>
<div class="prose">
    <p>
        This page highlights public repositories only. It is intended to show current platform work, learning projects, portfolio code,
        and older coursework that still helps document the range of languages and technologies I have used.
    </p>
</div>
<section class="content-section">
    <h2>
        Platform and developer foundations
    </h2>
    <div class="project-grid">
        <article class="project-card">
            <h3>
                Developer-Toolbox
            </h3>
            <p>
                Azure and Microsoft focused developer environment template with Dev Containers, Docker, .NET 8 / 9 / 10, Node.js, Terraform,
                PowerShell, Azure CLI, Azure Developer CLI, and repository standards.
            </p>
            <ul class="resource-list">
                <li>
                    <a href="https://github.com/AGameEmpowerment/Developer-Toolbox" target="_blank" rel="noopener">GitHub Developer-Toolbox &gt;&gt;</a>
                </li>
            </ul>
        </article>
        <article class="project-card">
            <h3>
                Starter-CSharp-Api
            </h3>
            <p>
                A new public starter repository representing my current direction for opinionated C# API scaffolding and maintainable project setup.
            </p>
            <ul class="resource-list">
                <li>
                    <a href="https://github.com/AGameEmpowerment/Starter-CSharp-Api" target="_blank" rel="noopener">GitHub Starter-CSharp-Api &gt;&gt;</a>
                </li>
            </ul>
        </article>
        <article class="project-card">
            <h3>
                Starter-CSharp-Azure-Function-App
            </h3>
            <p>
                A companion starter repository centered on Azure Function application setup and reusable serverless foundations in C#.
            </p>
            <ul class="resource-list">
                <li>
                    <a href="https://github.com/AGameEmpowerment/Starter-CSharp-Azure-Function-App" target="_blank" rel="noopener">GitHub Starter-CSharp-Azure-Function-App &gt;&gt;</a>
                </li>
            </ul>
        </article>
        <article class="project-card">
            <h3>
                seq-mcp
            </h3>
            <p>
                TypeScript MCP server that integrates AI agents with Datalust Seq through a controlled API surface, validation, and Docker packaging.
            </p>
            <ul class="resource-list">
                <li>
                    <a href="https://github.com/MCLifeLeader/seq-mcp" target="_blank" rel="noopener">GitHub seq-mcp &gt;&gt;</a>
                </li>
            </ul>
        </article>
        <article class="project-card">
            <h3>
                DotNetProjectStartup
            </h3>
            <p>
                Demonstration project for organizing modern .NET solutions with Docker, Dev Containers, Azure-related tooling, Aspire, and diagnostics.
            </p>
            <ul class="resource-list">
                <li>
                    <a href="https://github.com/MCLifeLeader/DotNetProjectStartup" target="_blank" rel="noopener">GitHub DotNetProjectStartup &gt;&gt;</a>
                </li>
            </ul>
        </article>
        <article class="project-card">
            <h3>
                Blazor-Chat-App
            </h3>
            <p>
                Learning-focused Blazor application using .NET 10, Aspire AppHost, Redis output caching, SQL Server, and Entity Framework Core.
            </p>
            <ul class="resource-list">
                <li>
                    <a href="https://github.com/MCLifeLeader/Blazor-Chat-App" target="_blank" rel="noopener">GitHub Blazor-Chat-App &gt;&gt;</a>
                </li>
            </ul>
        </article>
    </div>
</section>
<section class="content-section">
    <h2>
        Portfolio and teaching
    </h2>
    <div class="project-grid">
        <article class="project-card">
            <h3>
                ePortfolio
            </h3>
            <p>
                The repository for this portfolio website and a central place to document skills, projects, work history, and technical growth.
            </p>
            <ul class="resource-list">
                <li>
                    <a href="https://github.com/MCLifeLeader/ePortfolio" target="_blank" rel="noopener">GitHub ePortfolio &gt;&gt;</a>
                </li>
                <li>
                    <a href="https://github.com/MCLifeLeader/ePortfolio/wiki" target="_blank" rel="noopener">ePortfolio wiki &gt;&gt;</a>
                </li>
                <li>
                    <a href="https://mbcarey.com/" target="_blank" rel="noopener">Michael Carey's ePortfolio &gt;&gt;</a>
                </li>
            </ul>
        </article>
        <article class="project-card">
            <h3>
                ShortDevLessons
            </h3>
            <p>
                Teaching-oriented repository for helping homeschool students and beginners learn foundational programming concepts.
            </p>
            <ul class="resource-list">
                <li>
                    <a href="https://github.com/MCLifeLeader/ShortDevLessons" target="_blank" rel="noopener">GitHub ShortDevLessons &gt;&gt;</a>
                </li>
            </ul>
        </article>
        <article class="project-card">
            <h3>
                SeleniumExample
            </h3>
