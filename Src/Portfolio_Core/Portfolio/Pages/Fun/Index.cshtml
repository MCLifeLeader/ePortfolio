@page
@model Portfolio.Pages.Fun.IndexModel
@{
    ViewData["Title"] = "Fun Projects";
}

<h1>@ViewData["Title"]</h1>
<h3>@ViewData["Message"]</h3>
<section aria-labelledby="personal-context"><h2 id="personal-context">Personal projects and community</h2><p>These pages preserve the learning, gaming, radio, literary, and technical interests behind my personal projects. My Extra Class amateur radio license is current.</p><p><a asp-page="/AboutMe">About me</a> · <a asp-page="/Tribute">Tribute</a> · <a asp-page="/Experience/ResumeHistory">Personal achievements and earlier technical experience</a> · <a asp-page="/Explore">Full portfolio directory</a></p></section>

<div class="row pt-3">
    <div class="col-md-4">
        <h3>Solarian League Site</h3>
        <p>This fun project was created to help me gain further understanding in the development of front-end
            web applications using C# Blazor WebAsm and SPA. Data is sourced from Discord and an API pass through 
            Azure Function App that loads data from Blizzard.</p>
        <p>
            <a class="btn btn-info btn-site" asp-area="" asp-page="/Fun/SolarianLeague">Learn more >></a>
        </p>
    </div>
    <div class="col-md-4">
        <h3>Ham Radio Go-Kit</h3>
        <p>This is a how to guide to build a Ham Radio Go-Kit for VHF and UHF mobile radio.</p>
        <p>
            <a class="btn btn-info btn-site" asp-area="" asp-page="/Fun/HamRadioVHFGoKit">Learn more >></a>
        </p>
    </div>
</div>
